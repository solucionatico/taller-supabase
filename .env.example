# ==============================================================================
# Configuración pública del Frontend (Vue 3 + Vite)
# ==============================================================================
# Copia este archivo como `.env` en la raíz del proyecto:
#   cp .env.example .env   (Linux / macOS)
#   copy .env.example .env (Windows)
#
# Obtén estos valores en tu Supabase Dashboard:
#   Project Settings -> Data API / API Keys
#
# IMPORTANTE DE SEGURIDAD:
# - La clave publishable (o anon public) es segura para usar en el navegador
#   SIEMPRE Y CUANDO Row Level Security (RLS) esté habilitado en tus tablas.
# - NUNCA coloques aquí tu clave `service_role`, `secret key`, contraseñas de
#   PostgreSQL ni tokens personales de acceso.
# ==============================================================================

VITE_SUPABASE_URL=https://tu-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publicable-o-anon-key
