{
  "name": "taller-supabase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Proyecto didáctico full-stack de gestión de tareas personales con Vue 3, Vite, Supabase (PostgreSQL, Auth, RLS, Edge Functions) y Vercel.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "node scripts/check-environment.js",
    "setup": "node scripts/setup.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "supabase": "supabase",
    "vercel": "vercel",
    "deploy:db": "npm run supabase -- db push",
    "deploy:api": "node scripts/deploy-functions.js",
    "deploy:web": "npm run vercel -- --prod",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "supabase": "^2.20.5",
    "vercel": "^41.4.0",
    "vite": "^6.2.0"
  }
}
